#     timezone_offset_minutes: -300 # fallback when timezone is unset
#     daylight_saving: 1           # fallback when timezone is unset: 0=none, 1=+1h, 2=+2h
#     include_local_time_zone: true
#     include_universal_time_and_local_time_zone: true
#     include_daylight_saving_time: true
#   emm_information:
#     enabled: true
#     send_after_attach: true
#     send_after_tau: true
#   tau:
#     # Same-MME TAU normally does not need GUTI reallocation. Leave disabled
#     # unless a deployment explicitly wants privacy-driven TAU reallocation.
#     reallocate_guti: false
