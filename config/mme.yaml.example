nf:
  origin_host: "mme.epc.mnc001.mcc001.3gppnetwork.org"
  origin_realm: "epc.mnc001.mcc001.3gppnetwork.org"
  mcc: "001"
  mnc: "01"
  # Optional S1SetupResponse MMEname (TS 36.413 IE id 61). Leave empty to omit.
  mme_name: "vectorcore-mme"
  mmegi: 1
  mmec: 1
  relative_mme_capacity: 255
  tai_list:
    - mcc: "001"
      mnc: "01"
      tac: 1
    # Add one entry for every PLMN/TAC served by this MME. The eNB must
    # advertise the same complete PLMN + TAC in S1 Setup SupportedTAs.
    # - mcc: "001"
    #   mnc: "01"
    #   tac: 2
    # A network-sharing/multi-PLMN example:
    # - mcc: "311"
    #   mnc: "435"
    #   tac: 10

s1ap:
  bind_address: "0.0.0.0"
  bind_port: 36412
  sctp_streams: 2
  # Optional fixed outbound DSCP (0..63). Omit to use the OS default.
  # qos:
  #   dscp: 24 # CS3

sbcap:
  enabled: false
  bind_address: "0.0.0.0"
  port: 29168
  transaction_timeout: "30s"
  # Standards-strict by default. Set true only for a configured legacy CBC
  # known to send SBc-AP SCTP DATA with non-standard PPID 0.
  accept_legacy_ppid_zero: false
  # qos:
  #   dscp: 24 # CS3
  peers:
    # - name: "osmo-cbc"
    #   addresses:
    #     - "192.0.2.10"

diameter:
  origin_host: "mme.epc.mnc001.mcc001.3gppnetwork.org"
  origin_realm: "epc.mnc001.mcc001.3gppnetwork.org"
  # Optional local listener; outbound peer connections are maintained either way.
  # bind_addr: "0.0.0.0:3868"
  # bind_transport: "sctp" # tcp is the default
  retry_delay: "5s"
  # One outbound DSCP setting applies to every peer and Diameter application.
  # qos:
  #   dscp: 24 # CS3
  # The deployed peer is a DRA relay. Relay capability is learned from CEA.
  peers:
    - name: "dra-1"
      address: "127.0.0.2:3868"
      transport: "tcp" # tcp is the default


  # Dual-DRA active/standby: without priority, configuration order is primary/fallback.
  # peers:
  #   - name: "dra-1"
  #     address: "10.90.250.35:3868"
  #   - name: "dra-2"
  #     address: "10.90.250.36:3868"

  # Explicit priority: lower number wins, but only among peers of the same route class.
  # peers:
  #   - name: "dra-1"
  #     address: "10.90.250.35:3868"
  #     priority: 10
  #   - name: "dra-2"
  #     address: "10.90.250.36:3868"
  #     priority: 20

  # Mixed direct HSS plus DRA: discovered direct S6a capability beats relay.
  # peers:
  #   - name: "dra-1"
  #     address: "10.90.250.35:3868"
  #   - name: "hss-1"
  #     address: "10.90.250.40:3868"
  #     transport: "sctp"

s6a:
  # Send Purge-UE-Request on UE detach. Some deployments leave this disabled.
  send_pur_on_detach: true
  # Optional request shaping; these are the MME defaults and may be omitted.
  air:
    # Number of LTE authentication vectors requested from the HSS per AIR.
    requested_vectors: 1
    # Ask the HSS to return authentication data in the immediate answer.
    immediate_response_preferred: true
  ulr:
    # Default initial attach behavior: only S6a/S6d-Indicator (bit 2).
    flags: 2

# Roaming foundation only: this configuration is validated and available to
# later integration, but it does not yet route AIR/ULR or create S8 sessions.
# Keep disabled until the subsequent roaming integration phases are complete.
roaming:
  enabled: false
  policy:
    default_action: deny
    plmn_acl:
      - plmn:
          mcc: "310"
          mnc: "260"
        action: allow
      - plmn:
          mcc: "001"
          mnc: "01"
        action: deny
  hss_routes:
    - plmn:
        mcc: "310"
        mnc: "260"
      realm: epc.mnc260.mcc310.3gppnetwork.org
      host: hss01.epc.mnc260.mcc310.3gppnetwork.org

# S13 Equipment Identity Register checks are disabled unless explicitly enabled.
# When enabled, the MME advertises 3GPP S13 (Auth-Application-Id 16777252).
s13:
  enabled: false
  check_on_attach: true
  check_on_tau: false
  failure_policy: "allow" # allow (fail-open) or reject (fail-closed)
  # Equipment-Status policy (TS 29.272 §7.3.51). Defaults preserve the
  # common EIR behavior: allow white/grey equipment and reject blacklisted.
  whitelist_policy: "allow"
  blacklist_policy: "reject"
  greylist_policy: "allow"
  timeout: "5s"

# SMS in MME over SGd. Diameter peers/routes remain configured only above;
# this block only controls capability advertisement and S6a registration.
# Both numbers are E.164. The MME encodes them as TBCD without TON/NPI.
sgd:
  enabled: false
  subscribe_eps_only_attach: true
  smsc_address: "+15551230000"
  # tbcd is TS 29.338 compliant; ascii_digits supports legacy Cisco SMSCs.
  sgd_sc_address_encoding: "tbcd"
  transaction_timeout: "30s"
  mme_number_for_mt_sms: "+15551230001"

# Network-side EMM reachability supervision. T3412 remains the UE-facing
# nas.timers.t3412 value; the MME mobile-reachable interval is its effective
# encoded value plus this guard. A zero guard is permitted; implicit detach
# must remain positive so an unreachable context cannot persist indefinitely.
emm_timers:
  mobile_reachable_guard_seconds: 240
  implicit_detach_seconds: 300
  implicit_detach_cleanup_timeout_seconds: 30

s10:
  enabled: false
  bind_address: "0.0.0.0"
  bind_port: 2124
  # qos:
  #   dscp: 24 # CS3
  # peers:
  #   - name: "peer-mme"
  #     mmec: 2
  #     address: "10.0.0.2:2124"

s11:
  bind_address: "127.0.0.1"      # MME S11 local bind IP
  bind_port: 2123
  recovery_restart_counter: 0    # GTPv2 Recovery IE value used in Echo Response
  # qos:
  #   dscp: 24 # CS3

paging:
  # Enable S11 Downlink Data Notification driven S1AP paging for idle UEs.
  ddn_enabled: true
  retry_interval: "2s"
  max_attempts: 3
  transaction_timeout: "8s"

gateway_selection:
  dns:
    enabled: true
    root_domain: "epc.mnc001.mcc001.3gppnetwork.org"
    sgw_enabled: true
    pgw_enabled: true
    resolver:
      servers: []
      timeout: "2s"
      retries: 2
      prefer_ipv6: false
    cache:
      enabled: true
      min_ttl: "30s"
      max_ttl: "300s"
      negative_ttl: "10s"
  sgw:
    sgw_address: "127.0.0.3:2123"
  pgw:
    pgw_address: "127.0.0.4:2123"
    prefer_s6a_static: true

database:
  mode: "persistent"   # memory | persistent
  # Supported values: "postgres", "sqlite".
  db_type: "postgres"
  server: "localhost"
  port: 5432
  username: "mme"
  password: "changeme"
  database: "mme"
  # For SQLite, set db_type to "sqlite" and use database as the DB file path.
  # database: "/opt/vectorcore/var/mme.db"
  pool_size: 30
  pool_idle: 10

logging:
  level: "info"
  # file: "/opt/vectorcore/log/mme.log"

api:
  enabled: true
  bind_address: "0.0.0.0"
  bind_port: 8085

security:
  integrity_algorithms: ["EIA2", "EIA1", "EIA0"]
  ciphering_algorithms: ["EEA2", "EEA1", "EEA0"]

nas:
  eps_network_feature_support:
    # Advertise IMS voice-over-PS session support in Attach Accept and TAU Accept.
    # Keep false unless IMS service and the ims APN are available.
    ims_voice_over_ps: false
  timers:
    t3402: 720
    t3396: 720
    t3412: 3240
    t3423: 720

# operator:
